# Estado remoto. Sem isso o terraform.tfstate fica no disco de quem aplicou:
# ninguem mais consegue rodar apply, e se a maquina morrer o Terraform perde a
# referencia de tudo que criou.
#
# Renomeie para backend.tf DEPOIS de criar o bucket e a tabela de lock, e rode
# `terraform init -migrate-state`.
#
#   aws s3api create-bucket --bucket argus-tfstate-<conta> --region us-east-1
#   aws s3api put-bucket-versioning --bucket argus-tfstate-<conta> \
#     --versioning-configuration Status=Enabled
#   aws dynamodb create-table --table-name argus-terraform-locks \
#     --attribute-definitions AttributeName=LockID,AttributeType=S \
#     --key-schema AttributeName=LockID,KeyType=HASH \
#     --billing-mode PAY_PER_REQUEST --region us-east-1

terraform {
  backend "s3" {
    bucket         = "argus-tfstate-<conta>"
    key            = "ingestao-eventos/terraform.tfstate"
    region         = "us-east-1"
    dynamodb_table = "argus-terraform-locks"
    encrypt        = true
  }
}
