{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Backend Flask",
      "type": "debugpy",
      "request": "launch",
      "module": "flask",
      "args": ["--app", "telemetry:create_app", "run", "--debug"],
      "cwd": "${workspaceFolder}/apps/backend",
      "env": {
        "PYTHONPATH": "${workspaceFolder}/apps/backend/src"
      },
      "preLaunchTask": "Backend: instalar dependencias"
    }
  ]
}
