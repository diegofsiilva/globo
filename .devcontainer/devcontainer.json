{
  "name": "G04 Telemetry",
  "dockerComposeFile": "../compose.yaml",
  "service": "api",
  "workspaceFolder": "/workspaces/g04",
  "overrideCommand": true,
  "forwardPorts": [5000, 5432],
  "postCreateCommand": "pip install -e './backend[dev]'",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff"
      ]
    }
  }
}
