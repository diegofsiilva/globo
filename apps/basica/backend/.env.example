FLASK_DEBUG=1

# Tabela que o worker de ingestao escreve (ver infra/dynamodb.tf).
EVENTS_TABLE_NAME=argus-events-dev
AWS_REGION=us-east-1

# PRECISA bater com var.gsi1_shards do Terraform e GSI1_SHARDS do worker.
GSI1_SHARDS=10

USER_ID_HASH_SALT=troque-este-valor
DEFAULT_WINDOW_HOURS=168
CORS_ORIGINS=*

# Refinamento opcional das hipoteses. Para um Ollama remoto, aponte esta URL
# para a ponta local do tunel SSH; nunca registre usuario ou senha neste arquivo.
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=30
