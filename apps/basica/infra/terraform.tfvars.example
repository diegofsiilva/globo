# Copie para terraform.tfvars e ajuste. terraform.tfvars esta no .gitignore.
#
# O passo a passo do primeiro apply esta em artefatos/mvp-inicial.md §6.

region      = "us-east-1"
environment = "dev"

# --- AWS Academy / Learner Lab ----------------------------------------------
# Descomente as tres linhas abaixo se estiver aplicando num Learner Lab. Sao as
# duas unicas concessoes que o ambiente exige; numa conta normal, deixe como
# esta (roles dedicadas com permissao minima e chave KMS gerenciada).
#
# O lab nega iam:CreateRole e obriga a reusar a LabRole, que ja confia em
# apigateway.amazonaws.com e ecs-tasks.amazonaws.com. Monte o ARN com:
#
#   echo "arn:aws:iam::$(aws sts get-caller-identity --query Account --output text):role/LabRole"
#
# create_iam_roles  = false
# existing_role_arn = "arn:aws:iam::<sua-conta>:role/LabRole"
#
# O lab nao provisiona a chave gerenciada aws/dynamodb e o CreateTable falha com
# "KMS validation error ... does not exist". Com false a tabela usa a chave
# AWS-owned -- continua criptografada em repouso.
#
# dynamodb_kms_managed_key = false

# --- Rede -------------------------------------------------------------------
# Vazio usa a VPC/subnets default da conta.
# vpc_id     = "vpc-0123456789abcdef0"
# subnet_ids = ["subnet-aaa", "subnet-bbb"]

# true = subnet publica com IP publico, sem NAT Gateway (economiza ~US$ 32/mes).
# false exige subnet privada com NAT ou VPC endpoints -- ver infra/README.md.
assign_public_ip = true

# --- DynamoDB ---------------------------------------------------------------
retention_days = 90

# Shards da GSI1. Precisa ser IGUAL ao GSI1_SHARDS do worker.
# 1 em dev facilita a leitura; 10+ em producao evita particao quente.
gsi1_shards = 10

# --- Worker -----------------------------------------------------------------
worker_desired_count = 1
worker_cpu           = 256
worker_memory        = 512

# Aponte para o SHA do commit em vez de "latest" para deploy rastreavel.
# worker_image_tag = "sha-abc1234"

# --- Alarmes ----------------------------------------------------------------
# Sem e-mail, o topico SNS e criado mas ninguem e avisado.
# alarm_email = "voce@exemplo.com"

# --- Producao ---------------------------------------------------------------
# api_cors_allow_origins = ["https://seu-dominio.com.br"]
# container_insights     = "enabled"
