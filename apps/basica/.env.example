# Copie para .env e preencha. O .env esta no .gitignore.
#
# As URLs abaixo so existem DEPOIS do primeiro `terraform apply`: e o API
# Gateway que as gera. Por isso o caminho normal nao e copiar este arquivo a
# mao, e sim:
#
#   make -C apps/basica env  # le os outputs e escreve apps/basica/.env
#
# O passo a passo do zero (credenciais do lab -> apply -> carga -> URLs) esta em
# artefatos/plano-argus-v3.md §11.
#
# Nenhuma URL real de API, ID de conta ou segredo deve ser commitado, nem em
# codigo, nem em documentacao. Para pegar um valor isolado:
#
#   cd apps/basica/infra
#   terraform output -raw read_api_url       # API de leitura (dashboard)
#   terraform output -raw ingest_url         # API de ingestao (eventos de sessao)
#   terraform output -raw changes_url        # API de mudancas (CDC do simulador)
#   terraform output -raw database_url_hint  # como montar a DATABASE_URL

# --- API de leitura, consumida pelo dashboard ---
ARGUS_API_URL=

# --- API de ingestao, usada pelo replay de eventos de sessao ---
ARGUS_INGEST_URL=

# --- API de mudancas (CDC). E nela que o simulador publica os change events ---
ARGUS_CHANGES_URL=

# --- Banco ---
#
# Conexao de ESCRITA (dono do schema): usada por `make migrate`, `make etl`,
# `make count` e pela carga inicial. A senha do RDS fica no Secrets Manager, e
# nao aqui — `make db-url` imprime como montar a URL a partir dele:
#
#   DATABASE_URL=postgresql://argus:<senha>@<endpoint>:5432/argus
#
# Para o banco LOCAL (`make db-local`), a URL e fixa e sem segredo nenhum:
#
#   DATABASE_URL=postgresql://argus:argus@localhost:55432/argus
DATABASE_URL=

# Senha do usuario de LEITURA (`argus_reader`), o unico que a Lambda usa. Tem de
# ser identica a `read_api_db_password` do terraform.tfvars: o Terraform grava a
# senha na variavel de ambiente da Lambda, e `make db-reader` cria o usuario no
# banco com ela. Divergir entre as duas so aparece como falha de autenticacao no
# /health/ready, bem depois do apply.
DB_READER_PASSWORD=

# --- AWS ---
#
# Sempre o profile do Learner Lab. O profile default e outra conta: um comando
# sem `--profile` provisiona no lugar errado.
AWS_PROFILE=g4
AWS_REGION=us-east-1
