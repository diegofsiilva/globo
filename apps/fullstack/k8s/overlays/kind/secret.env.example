# Copie para secret.env (que esta no .gitignore) antes de `make kind-up`.
#
# Sao valores de brincadeira, para um banco que vive dentro do cluster e morre
# com ele. Nenhum deles serve para a AWS -- la o Secret e montado por
# `make k8s-secret`, que le os outputs do Terraform e nunca escreve em disco.

# sslmode=disable e nao require: o Postgres do kind nao tem certificado. Na AWS
# o valor e require, e a diferenca esta aqui de proposito.
DATABASE_URL=postgresql://argus:argus@argus-postgres:5432/argus?sslmode=disable

# No kind nao ha separacao de privilegio: o mesmo usuario aplica as migrations e
# le. Na AWS sao dois (mestre e argus_api), e o Job de migration depende disso.
DATABASE_URL_MASTER=postgresql://argus:argus@argus-postgres:5432/argus?sslmode=disable

DB_READER_PASSWORD=argus-reader-local
USER_ID_HASH_SALT=local-development-only

# Vazio porque AUTH_REQUIRED=0 no config-patch.yaml.
DASHBOARD_TOKEN_SHA256=
