{
  // Ambiente pronto para `make dev`: Python 3.12, uv, Node 20, Docker e make.
  //
  // Vive em apps/fullstack, e nao na raiz, porque a raiz do repositorio e fixa
  // (exigencia academica; AGENTS.md regra 1). No VS Code: "Dev Containers:
  // Open Folder in Container..." apontando para apps/fullstack. O Codespaces
  // so procura .devcontainer na raiz e por isso nao encontra este arquivo.
  //
  // O bind mount e o REPOSITORIO inteiro (dois niveis acima), e a pasta aberta
  // e apps/fullstack dentro dele. Montar so apps/fullstack deixaria o .git de
  // fora do container -- sem git, sem Source Control -- e esconderia
  // ../../data/parquet, que `make dev-seed` procura.
  "name": "Argus (apps/fullstack)",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": { "version": "20" },
    // Docker-in-Docker: `make db-local` sobe o PostgreSQL num container.
    "ghcr.io/devcontainers/features/docker-in-docker:2": {},
    "ghcr.io/va-h/devcontainers-features/uv:1": {}
  },
  "workspaceMount": "source=${localWorkspaceFolder}/../..,target=/workspaces/g04,type=bind,consistency=cached",
  "workspaceFolder": "/workspaces/g04/apps/fullstack",
  // Next dev + PostgreSQL + os ambientes uv pedem folga; abaixo disto o
  // `next dev` compila lento o bastante para parecer travado.
  "hostRequirements": { "cpus": 4, "memory": "8gb" },
  "forwardPorts": [3000, 5000, 55432],
  "portsAttributes": {
    "3000": { "label": "Dashboard", "onAutoForward": "openBrowser" },
    "5000": { "label": "API de leitura", "onAutoForward": "silent" },
    "55432": { "label": "PostgreSQL local", "onAutoForward": "silent" }
  },
  // Dependencias uma vez, na criacao. O banco NAO sobe aqui: o daemon do
  // Docker-in-Docker ainda esta iniciando quando o postCreate roda, e o
  // primeiro `make dev` ja o levanta com `db-ensure`.
  "postCreateCommand": "make install frontend-install",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-python.python",
        "ms-python.debugpy",
        "charliermarsh.ruff",
        "dbaeumer.vscode-eslint",
        "esbenp.prettier-vscode",
        "bradlc.vscode-tailwindcss",
        "ms-azuretools.vscode-docker",
        "ms-kubernetes-tools.vscode-kubernetes-tools",
        "hashicorp.terraform"
      ],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"],
        "[python]": { "editor.defaultFormatter": "charliermarsh.ruff" },
        "eslint.workingDirectories": ["frontend"]
      }
    }
  }
}
