# Copie para terraform.tfvars e ajuste. terraform.tfvars esta no .gitignore.
#
# O passo a passo do primeiro apply esta em artefatos/plano-argus-v3.md, §5 e §9.

region      = "us-east-1"
environment = "dev"

# --- AWS Academy / Learner Lab ----------------------------------------------
# As tres concessoes que o Learner Lab exige. Numa conta normal, comente as tres
# secoes: o padrao cria roles dedicadas com permissao minima, guarda a senha do
# banco no Secrets Manager e mantem o RDS privado.
#
# O lab nega iam:CreateRole e obriga a reusar a LabRole, que ja confia em
# apigateway.amazonaws.com, ecs-tasks.amazonaws.com, lambda.amazonaws.com e
# rds.amazonaws.com.
#
# ATENCAO: o id da conta MUDA a cada sessao nova do laboratorio. Confira com
#
#   aws sts get-caller-identity --profile g4 --query Account --output text
#
# e atualize a linha abaixo antes do apply. E confirme que a sessao esta viva
# de verdade com uma chamada que exija permissao real --
# `aws ec2 describe-vpcs --profile g4` --, porque o get-caller-identity
# continua respondendo normalmente mesmo depois de a credencial ser cancelada.
create_iam_roles  = false
existing_role_arn = "arn:aws:iam::000000000000:role/LabRole"

# --- Banco ------------------------------------------------------------------
# Confirme que o laboratorio libera a classe antes do apply:
#
#   aws rds describe-orderable-db-instance-options --engine postgres \
#     --engine-version 16.15 --profile g4 --region us-east-1 \
#     --query 'OrderableDBInstanceOptions[].DBInstanceClass' --output text
#
# Plano B se a classe for negada: db.t3.small ou micro. Continua viavel porque
# as telas leem gold.v_* e nunca bronze -- o tamanho de prom_point nao entra no
# caminho de leitura do dashboard.
db_instance_class    = "db.t3.medium"
db_allocated_storage = 100

# O lab pode negar o Secrets Manager. Com false, a senha vem da linha abaixo --
# que esta neste arquivo justamente porque ele NAO e versionado.
db_password_from_secrets_manager = false
db_password                      = "troque-por-uma-senha-longa-de-verdade"

# RDS eh privado por exigencia da rubrica (3) — fixado em false em rds.tf.
# Para inspecionar/migrar use a task dentro da VPC (make migrate-aws), nao IP publico.
# db_publicly_accessible DEVE ser false; qualquer outro valor falha no validate.
# db_allowed_cidr so tem efeito se a instancia fosse publica, o que nao ocorre mais;
# mantenha vazio (padrao seguro) ou remova a linha.
db_publicly_accessible = false
db_allowed_cidr        = ""

# --- Usuario de leitura da API ----------------------------------------------
# Precisa ser a MESMA senha que voce passar em DB_READER_PASSWORD ao rodar
#   make db-reader
# O Terraform nao cria este usuario (as migrations criam), entao os dois lados
# so concordam se voce usar o mesmo valor nos dois.
read_api_db_user     = "argus_api"
read_api_db_password = "outra-senha-longa-so-para-leitura"

# --- Rede -------------------------------------------------------------------
# VPC dedicada: sub-redes publica e privada em duas AZs, NAT Gateway, bastion,
# ALB e Auto Scaling Group. `false` volta ao comportamento anterior (VPC default
# da conta, IP publico nas tasks).
#
# CUIDADO ao trocar para `false` num ambiente ja aplicado: o RDS nao muda de VPC,
# e mover o subnet group forca a SUBSTITUICAO da instancia -- o que apaga o banco.
create_network = true

# As duas chaves andam JUNTAS, e o Terraform recusa a combinacao errada no plan.
# Com create_network = true a task vai para a sub-rede privada, que nao tem rota
# para o Internet Gateway: pedir IP publico ali nao da saida nenhuma -- so faz o
# pull do ECR falhar e o service entrar em crash loop.
#   create_network = true  -> assign_public_ip = false  (sai pelo NAT)
#   create_network = false -> assign_public_ip = true   (VPC default, desenho antigo)
assign_public_ip = false

# As faixas saem de vpc_cidr por derivacao. Preencher public_subnet_cidrs e
# private_subnet_cidrs a mao so faz sentido para casar com uma rede que ja
# exista -- e ai as duas listas precisam caber dentro de vpc_cidr.
vpc_cidr = "10.0.0.0/16"

# `vpc_id` e `subnet_ids` so servem para injetar uma rede pre-existente, quando
# create_network = false. Vazios usam a VPC default da conta.

# --- Observabilidade de rede ------------------------------------------------
# Destino dos VPC Flow Logs. `s3` e o padrao, e no AWS Academy e o UNICO que
# funciona: o caminho do CloudWatch exige um papel que confie em
# vpc-flow-logs.amazonaws.com, e a LabRole nao confia (verificado na conta).
flow_logs_destination = "s3"

# Buckets criados FORA do Terraform, para contornar a SCP do AWS Academy, que
# nega s3:GetBucketObjectLockConfiguration -- a API que o provider chama ao
# reler qualquer bucket recem-criado. Sem isto o bucket nasce, o apply falha na
# releitura e o recurso fica no estado quebrando todo plan seguinte.
#
#   aws s3api create-bucket --bucket <nome> --region us-east-1 --profile g4
#
# Numa conta sem essa restricao, deixe os dois vazios.
# flow_logs_bucket_name = "argus-flow-logs-<conta>"
# alb_logs_bucket_name  = "argus-alb-logs-<conta>"

# --- Bastion ----------------------------------------------------------------
# Vazio NAO cria o bastion (sem chave a instancia seria inalcancavel). Crie o
# par com `aws ec2 create-key-pair --profile g4` e guarde o .pem FORA do repo.
# bastion_key_name = "argus-bastion"

# Unico CIDR autorizado na porta 22. Ponha o SEU IP em /32.
# A validacao recusa 0.0.0.0/0 de proposito.
# bastion_allowed_cidr = "203.0.113.10/32"

# --- Auto Scaling Group e ALB -----------------------------------------------
# Instancias Graviton (arm64): TODAS as imagens deste repositorio sao arm64.
# Trocar por familia x86 (t3/t2) exige trocar a AMI em bastion.tf tambem.
app_instance_type = "t4g.small"

asg_min_size         = 2
asg_max_size         = 6
asg_desired_capacity = 2

# Requisicoes por instancia por minuto. Acima disso o grupo cresce.
asg_target_requests_per_target = 60

# No Learner Lab o profile ja existe e vem anexado a LabRole -- pelo mesmo
# motivo de existing_role_arn: o papel voclabs recusa iam:CreateRole.
instance_profile_name = "LabInstanceProfile"

# --- Servicos ---------------------------------------------------------------
worker_desired_count = 1
worker_cpu           = 256
worker_memory        = 512

# O simulador comeca DESLIGADO: ele so faz sentido depois de a carga inicial ter
# rodado. Ligue com `make sim-on` quando as 33 tabelas estiverem cheias.
simulator_desired_count = 0
simulator_speed         = 60

# O container de processamento e no-op (decisao 7). 1 mantem a infraestrutura
# observavel; 0 economiza credito enquanto nao ha logica la dentro.
processing_desired_count = 1

# --- Alarmes ----------------------------------------------------------------
# Sem e-mail, o topico SNS e criado mas ninguem e avisado.
# alarm_email = "voce@exemplo.com"

# --- Privacidade ------------------------------------------------------------
# Salt do hash de user_id na saida da API (RNF10).
user_id_hash_salt = "troque-este-valor"

# --- Kubernetes (EKS Auto Mode) ---------------------------------------------
#
# O cluster orquestra o caminho SINCRONO: dashboard, API de leitura e o Job de
# migration. O caminho assincrono (workers de SQS, processing, simulator,
# loader) continua no ECS Fargate, sem alteracao -- ver o cabecalho de eks.tf.
#
# Desligado por padrao: o control plane cobra por hora existindo, e o orcamento
# do Learner Lab e finito. Depois da entrega, voltar para false e aplicar
# derruba o cluster inteiro sem tocar no resto do stack.
create_eks = false

# Quando create_eks = true, zere o Auto Scaling Group: foi ele que o cluster
# substituiu, e deixar os dois de pe paga duas vezes pela mesma API.
# asg_min_size         = 0
# asg_desired_capacity = 0

# Os papeis do EKS ja existem na conta do lab e sao descobertos por regex
# (iam:CreateRole e negado, e o prefixo do nome muda a cada sessao). Preencha
# abaixo APENAS se `terraform plan` falhar com AccessDenied em iam:ListRoles --
# `make eks-roles` imprime os dois valores.
# eks_cluster_role_arn = ""
# eks_node_role_arn    = ""

# Fechar o endpoint do control plane no IP do laboratorio e uma melhoria barata
# quando o endereco e estavel.
# eks_public_access_cidrs = ["0.0.0.0/0"]
