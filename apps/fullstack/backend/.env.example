# Variaveis da API de leitura quando ela roda SOLTA (run.py / Run and Debug).
# O caminho normal e `make -C .. dev` ou `make -C .. api`, que ja passam
# DATABASE_URL e PORT; este arquivo existe para quem sobe o run.py na mao.
# Copie para .env e ajuste. O .env esta no .gitignore.
FLASK_DEBUG=1
PORT=5000

# Banco local de `make -C .. db-local` (porta 55432, sem segredo nenhum).
# Desde a v3 a persistencia e PostgreSQL; nao ha mais DynamoDB, e por isso
# EVENTS_TABLE_NAME e GSI1_SHARDS deixaram de existir (config.py nao os le).
DATABASE_URL=postgresql://argus:argus@localhost:55432/argus
AWS_REGION=us-east-1

# 0 no ambiente local: a API ignora o token e a tela de acesso do dashboard
# aceita 64 zeros. Com 1, DASHBOARD_TOKEN_SHA256 passa a ser obrigatoria.
AUTH_REQUIRED=0

USER_ID_HASH_SALT=troque-este-valor
DEFAULT_WINDOW_HOURS=168
CORS_ORIGINS=*

# Refinamento opcional das hipoteses. O canal SSH nasce automaticamente.
OLLAMA_SSH_HOST=
OLLAMA_SSH_PORT=22
OLLAMA_SSH_USER=
OLLAMA_SSH_PASSWORD=
OLLAMA_REMOTE_HOST=127.0.0.1
OLLAMA_REMOTE_PORT=11434
OLLAMA_URL=http://ollama.internal:11434
# Opcional: vazio seleciona automaticamente o primeiro modelo instalado.
OLLAMA_MODEL=
OLLAMA_TIMEOUT_SECONDS=90
