        <mxCell id="ap3c2" value="N queries paralelas (dias x shards)" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ap">
          <mxGeometry x="580" y="102" width="460" height="24" as="geometry" />
        </mxCell>
        <mxCell id="ap4c0" value="table:scan" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ap">
          <mxGeometry x="0" y="126" width="260" height="24" as="geometry" />
