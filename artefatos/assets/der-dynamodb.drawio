        <mxCell id="ap4c2" value="varre a tabela" style="text;html=1;strokeColor=none;fillColor=none;align=left;verticalAlign=middle;spacingLeft=8;fontSize=11;fontFamily=Courier New;" vertex="1" parent="ap">
          <mxGeometry x="580" y="126" width="460" height="24" as="geometry" />
        </mxCell>

        <mxCell id="p2nota" value="&lt;b&gt;Por que o shard existe.&lt;/b&gt; Sem o sufixo #&amp;lt;shard&amp;gt;, todo evento de um mesmo tipo num mesmo dia cairia na mesma parti&#231;&#227;o, e parti&#231;&#227;o do DynamoDB satura em 1000 WCU &#8212; o gargalo cl&#225;ssico de ingest&#227;o de s&#233;rie temporal. O pre&#231;o &#233; que a leitura vira fan-out de N queries paralelas.&#xa;&#xa;&lt;b&gt;Os tr&#234;s precisam concordar.&lt;/b&gt; gsi1_shards (Terraform), GSI1_SHARDS (worker) e GSI1_SHARDS (API) montam a mesma chave. Divergir faz a leitura consultar parti&#231;&#245;es onde a escrita nunca colocou nada &#8212; e o resultado &#233; consulta vazia, sem erro nenhum." style="text;html=1;align=left;whiteSpace=wrap;verticalAlign=top;fontSize=12;fontColor=#333333;spacingLeft=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1040" height="130" as="geometry" />
        </mxCell>
      </root>
