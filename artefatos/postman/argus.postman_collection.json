    {
      "name": "1. Leitura, eventos e métricas",
      "item": [
        {
          "name": "1.1 Saúde da API",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/health/ready",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "health",
                "ready"
              ]
            },
            "description": "Sonda de readiness: confirma que a API alcança o RDS PostgreSQL."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('o banco está alcançável', () => pm.expect(pm.response.json().status).to.eql('ok'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.2 Busca sem filtro (particao_por_tempo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/events?limit=50",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "limit",
                  "value": "50"
                }
              ]
            },
            "description": "Sem session_id, device_id ou event_name, a consulta cai na janela de tempo padrão (RNF02), usa o índice por `ts`."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve uma página de eventos', () => pm.expect(corpo.items).to.be.an('array'));",
                  "  pm.test('usa a estrategia particao_por_tempo', () => pm.expect(corpo.query.strategy).to.eql('particao_por_tempo'));",
                  "pm.test('expõe o custo da consulta', () => {",
                  "  pm.expect(corpo.query.scanned).to.be.at.least(corpo.query.returned);",
                  "});",
                  "pm.test('responde em menos de 3s (RNF02)', () => pm.expect(pm.response.responseTime).to.be.below(3000));",
                  "",
                  "// Guarda um id real para as consultas indexadas seguintes.",
                  "if (corpo.items.length) {",
                  "  pm.collectionVariables.set('sessao_existente', corpo.items[0].session_id);",
                  "  pm.collectionVariables.set('aparelho_existente', corpo.items[0].device_id);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "1.3 Busca por tipo (indice_tipo_e_tempo)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/events?event_name=error&limit=20",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "event_name",
                  "value": "error"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "Com event_name, a consulta usa o índice por tipo e tempo, uma única query, não fan-out (isso era comportamento do DynamoDB v2)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "  pm.test('usa o indice_tipo_e_tempo', () => pm.expect(corpo.query.strategy).to.eql('indice_tipo_e_tempo'));",
                  "pm.test('o filtro foi aplicado', () => {",
                  "  corpo.items.forEach(e => pm.expect(e.event_name).to.eql('error'));",
                  "});",
                  "  pm.test('resolve em uma unica query (Postgres, nao ha fan-out)', () => pm.expect(corpo.query.queries).to.eql(1));",
                  "pm.test('responde em menos de 3s (RNF02)', () => pm.expect(pm.response.responseTime).to.be.below(3000));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.4 Linha do tempo da sessão (indice_sessao)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/sessions/{{sessao_existente}}",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{sessao_existente}}"
              ]
            },
            "description": "Consulta mais barata do sistema: uma partição. É a tela de investigação de incidente."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "  pm.test('usa o indice_sessao', () => pm.expect(corpo.query.strategy).to.eql('indice_sessao'));",
                  "pm.test('resolve em uma única query', () => pm.expect(corpo.query.queries).to.eql(1));",
                  "pm.test('a linha do tempo é cronológica', () => {",
                  "  const horarios = corpo.events.map(e => e.occurred_at);",
                  "  pm.expect(horarios).to.eql([...horarios].sort());",
                  "});",
                  "pm.test('traz o resumo da sessão', () => pm.expect(corpo.summary).to.have.property('event_count'));"
                ]
              }
            }
          ]
        },
        {
          "name": "1.5 Histórico do aparelho (indice_aparelho)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/devices/{{aparelho_existente}}",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "devices",
                "{{aparelho_existente}}"
              ]
            },
            "description": "Histórico de um aparelho ao longo do tempo, pelo índice por device_id."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "  pm.test('usa o indice_aparelho', () => pm.expect(corpo.query.strategy).to.eql('indice_aparelho'));",
                  "pm.test('todos os eventos são do aparelho pedido', () => {",
                  "  const esperado = pm.collectionVariables.get('aparelho_existente');",
                  "  corpo.items.forEach(e => pm.expect(e.device_id).to.eql(esperado));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.6 Valores para os filtros (facets)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/facets?field=event_name&field=device_manufacturer",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "facets"
              ],
              "query": [
                {
                  "key": "field",
                  "value": "event_name"
                },
                {
                  "key": "field",
                  "value": "device_manufacturer"
                }
              ]
            },
            "description": "Alimenta o autocompletar dos filtros do dashboard (RF10)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const facets = pm.response.json().facets;",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve valores por campo', () => {",
                  "  pm.expect(facets.event_name).to.be.an('array').that.is.not.empty;",
                  "  pm.expect(facets.device_manufacturer).to.be.an('array').that.is.not.empty;",
                  "});",
                  "pm.test('os seis tipos conhecidos aparecem', () => {",
                  "  ['request', 'screen_view', 'session', 'video_view', 'vitals', 'error']",
                  "    .forEach(t => pm.expect(facets.event_name).to.include(t));",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.7 Agrupamento por fabricante (breakdown)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/metrics/breakdown?dimension=device_manufacturer&limit=10",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "metrics",
                "breakdown"
              ],
              "query": [
                {
                  "key": "dimension",
                  "value": "device_manufacturer"
                },
                {
                  "key": "limit",
                  "value": "10"
                }
              ]
            },
            "description": "A agregação roda no banco via GROUP BY, direto sobre a silver, ainda não há camada gold pré-agregada para sessão/evento (RF11; ver mapa-tratamentos-bronze-silver-gold.md)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve grupos ordenados', () => pm.expect(corpo.groups).to.be.an('array').that.is.not.empty);",
                  "pm.test('a soma dos grupos fecha com o total', () => {",
                  "  const soma = corpo.groups.reduce((acc, g) => acc + g.count, 0);",
                  "  pm.expect(soma).to.be.at.most(corpo.total);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.8 Série temporal com comparação",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/metrics/timeseries?interval=60&compare=true&from={{janela_de}}&to={{janela_ate}}",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "metrics",
                "timeseries"
              ],
              "query": [
                {
                  "key": "interval",
                  "value": "60"
                },
                {
                  "key": "compare",
                  "value": "true"
                },
                {
                  "key": "from",
                  "value": "{{janela_de}}"
                },
                {
                  "key": "to",
                  "value": "{{janela_ate}}"
                }
              ]
            },
            "description": "Com compare=true a API devolve também a janela anterior de mesma duração e a variação entre as duas (RF14), é o que permite dizer 'os erros dobraram'."
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Janela dos últimos 7 dias, calculada na hora: uma data fixa no",
                  "// arquivo faria este teste passar hoje e falhar no mês que vem.",
                  "const ate = new Date();",
                  "const de = new Date(ate.getTime() - 7 * 24 * 60 * 60 * 1000);",
                  "pm.collectionVariables.set('janela_de', de.toISOString());",
                  "pm.collectionVariables.set('janela_ate', ate.toISOString());"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('devolve os baldes da série', () => pm.expect(corpo.buckets).to.be.an('array'));",
                  "pm.test('devolve a comparação com o período anterior', () => {",
                  "  pm.expect(corpo).to.have.property('previous');",
                  "  pm.expect(corpo).to.have.property('change');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.9 Privacidade: nada de user_id nem authorization",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/events?event_name=request&limit=20",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "event_name",
                  "value": "request"
                },
                {
                  "key": "limit",
                  "value": "20"
                }
              ]
            },
            "description": "RNF10. O worker grava o evento cru, com user_id e o header authorization; a remoção acontece na SAÍDA da API. Este teste é a trava dessa garantia."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const texto = pm.response.text();",
                  "const corpo = pm.response.json();",
                  "pm.test('responde 200', () => pm.response.to.have.status(200));",
                  "pm.test('o header authorization nunca sai', () => {",
                  "  pm.expect(texto.toLowerCase()).to.not.include('authorization');",
                  "});",
                  "pm.test('o user_id cru nunca sai, só o hash', () => {",
                  "  corpo.items.forEach(e => {",
                  "    pm.expect(e).to.not.have.property('user_id');",
                  "  });",
                  "});",
                  "pm.test('response_headers é removido inteiro', () => {",
                  "  corpo.items.forEach(e => {",
                  "    pm.expect(e.attributes || {}).to.not.have.property('response_headers');",
                  "  });",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.10 Erro: período inválido devolve 422",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/events?from=ontem",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "events"
              ],
              "query": [
                {
                  "key": "from",
                  "value": "ontem"
                }
              ]
            },
            "description": "Erro de cliente no formato Problem Details (RFC 7807), apontando o campo culpado."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 422 e não 500', () => pm.response.to.have.status(422));",
                  "pm.test('aponta qual campo causou a recusa', () => {",
                  "  pm.expect(pm.response.json().field).to.eql('from');",
                  "});",
                  "pm.test('usa o formato Problem Details', () => {",
                  "  pm.expect(pm.response.headers.get('Content-Type')).to.include('problem+json');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "1.11 Erro: sessão inexistente devolve 404",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/sessions/sessao-que-nao-existe",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "sessao-que-nao-existe"
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 404', () => pm.response.to.have.status(404));"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "2. POST, API de ingestão",
      "item": [
        {
          "name": "AVISO, não verificado nesta rodada",
          "request": {
            "method": "GET",
            "url": {
              "raw": "",
              "host": [
                ""
              ]
            },
            "description": "Esta pasta (POST, API de ingestão) não foi revisada nesta etapa. O trabalho desta rodada cobriu só a API de LEITURA (apps/basica/backend). Os testes abaixo assumem a integração API Gateway -> SQS direta descrita em plano-argus-v3.md; confirmar contra apps/basica/worker antes de rodar em CI."
          }
        },
        {
          "name": "2.1 Evento único",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ingest_url}}",
              "host": [
                "{{ingest_url}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{ts_e2e}}\",\n  \"event_name\": \"error\",\n  \"session_id\": \"{{session_e2e}}\",\n  \"device_id\": \"{{device_e2e}}\",\n  \"app_target\": \"dom-postman-teste\",\n  \"app_version\": \"2026.3.0\",\n  \"app_env\": \"production\",\n  \"device_manufacturer\": \"Postman\",\n  \"device_model\": \"COLLECTION-RUNNER\",\n  \"device_os\": \"Newman\",\n  \"route_path\": \"vod\",\n  \"duration\": 1.5,\n  \"error_name\": \"Erro de teste do Postman\",\n  \"error_message\": \"Evento sintetico da colecao de testes\",\n  \"error_stack\": \"postman:1_0001\"\n}"
            },
            "description": "Ingestão de um evento. O API Gateway publica direto no SQS, sem Lambda no caminho."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a fila aceitou o evento', () => pm.response.to.have.status(200));",
                  "pm.test('aceita rápido: a TV não espera a gravação', () => {",
                  "  pm.expect(pm.response.responseTime).to.be.below(3000);",
                  "});",
                  "// A resposta é o XML do SQS, não JSON: HTTP API repassa a resposta crua",
                  "// do serviço integrado e não transforma corpo, só cabeçalho e status.",
                  "pm.test('a resposta é o XML do SQS (comportamento documentado)', () => {",
                  "  pm.expect(pm.response.text()).to.include('SendMessageResponse');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "2.2 Lote de três eventos",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ingest_url}}",
              "host": [
                "{{ingest_url}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"events\": [\n    {\n      \"timestamp\": \"{{ts_e2e}}\",\n      \"event_name\": \"screen_view\",\n      \"session_id\": \"{{session_e2e}}\",\n      \"device_id\": \"{{device_e2e}}\",\n      \"route_path\": \"home\",\n      \"app_target\": \"dom-postman-teste\"\n    },\n    {\n      \"timestamp\": \"{{ts_e2e}}\",\n      \"event_name\": \"video_view\",\n      \"session_id\": \"{{session_e2e}}\",\n      \"device_id\": \"{{device_e2e}}\",\n      \"action\": \"open\",\n      \"media_id\": \"4452349\",\n      \"media_kind\": \"live\",\n      \"media_ads\": true\n    },\n    {\n      \"timestamp\": \"{{ts_e2e}}\",\n      \"event_name\": \"vitals\",\n      \"session_id\": \"{{session_e2e}}\",\n      \"device_id\": \"{{device_e2e}}\",\n      \"action\": \"frozen\",\n      \"duration\": 4.2\n    }\n  ]\n}"
            },
            "description": "O worker aceita três formas de corpo: um evento, uma lista, ou o envelope {\"events\": [...]}. Vários eventos por mensagem é o que aproveita o batching do BatchWriteItem."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a fila aceitou o lote', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.3 Reenvio idêntico, idempotência",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ingest_url}}",
              "host": [
                "{{ingest_url}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{ts_e2e}}\",\n  \"event_name\": \"error\",\n  \"session_id\": \"{{session_e2e}}\",\n  \"device_id\": \"{{device_e2e}}\",\n  \"app_target\": \"dom-postman-teste\",\n  \"app_version\": \"2026.3.0\",\n  \"app_env\": \"production\",\n  \"device_manufacturer\": \"Postman\",\n  \"device_model\": \"COLLECTION-RUNNER\",\n  \"device_os\": \"Newman\",\n  \"route_path\": \"vod\",\n  \"duration\": 1.5,\n  \"error_name\": \"Erro de teste do Postman\",\n  \"error_message\": \"Evento sintetico da colecao de testes\",\n  \"error_stack\": \"postman:1_0001\"\n}"
            },
            "description": "Corpo byte a byte idêntico ao de 2.1. O event_id é o sha256 do conteúdo, então este reenvio produz a MESMA chave e vira um overwrite idêntico no DynamoDB, não uma linha nova. A verificação está na pasta 3."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a fila aceitou o reenvio', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.4 Tipo de evento desconhecido",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ingest_url}}",
              "host": [
                "{{ingest_url}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"timestamp\": \"{{ts_e2e}}\",\n  \"event_name\": \"postman_probe\",\n  \"session_id\": \"{{session_e2e}}\",\n  \"device_id\": \"{{device_e2e}}\",\n  \"campo_que_o_backend_nunca_viu\": \"preservado\",\n  \"outro_campo_novo\": 42\n}"
            },
            "description": "O pipeline aceita event_name desconhecido DE PROPÓSITO: o parque de TVs atualiza devagar, e um modelo estrito transformaria qualquer mudança de schema no app em perda de dados em massa. O evento cai em GenericEvent, é gravado com os campos extras, e aparece no dashboard no mesmo dia."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('a fila aceitou o tipo novo', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ]
        },
        {
          "name": "2.5 Payload inválido, rejeição assíncrona",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{ingest_url}}",
              "host": [
                "{{ingest_url}}"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"event_name\": \"error\",\n  \"sem_timestamp\": true,\n  \"sem_session_id\": true,\n  \"sem_device_id\": true\n}"
            },
            "description": "ACHADO IMPORTANTE, e contraintuitivo.\n\nEste payload é inválido: faltam timestamp, session_id e device_id. Ainda assim a resposta é **HTTP 200**.\n\nO motivo: a integração direta API Gateway → SQS não tem request validator (só o REST API tem, o HTTP API não), então o payload entra cru na fila e quem valida é o worker. A rejeição é assíncrona, o evento vai para a DLQ com o motivo anexado.\n\nÉ uma troca deliberada: para telemetria, aceitar rápido e validar depois é melhor que segurar a TV do usuário esperando validação. Mas quem consome a API precisa saber que 200 aqui significa 'enfileirado', não 'válido'.\n\nVerificação: `make dlq` mostra os eventos rejeitados com o motivo."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('responde 200 mesmo com payload inválido', () => {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('a rejeição não é sincrona: nada no corpo indica erro', () => {",
                  "  pm.expect(pm.response.text()).to.include('SendMessageResponse');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "3. Verificação end-to-end",
      "item": [
        {
          "name": "3.1 Os eventos postados chegaram ao banco",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{read_url}}/api/v1/sessions/{{session_e2e}}",
              "host": [
                "{{read_url}}"
              ],
              "path": [
                "api",
                "v1",
                "sessions",
                "{{session_e2e}}"
              ]
            },
            "description": "Fecha o ciclo: consulta pela API de LEITURA a sessão que a pasta 2 criou pela API de INGESTÃO.\n\nEspera 5 eventos únicos:\n- 1 de 2.1 (error)\n- 3 de 2.2 (screen_view, video_view, vitals)\n- 1 de 2.4 (tipo desconhecido)\n\nO reenvio de 2.3 NÃO conta, mesma chave, overwrite. E o payload inválido de 2.5 também não: foi para a DLQ.\n\nA requisição repete a si mesma enquanto o worker não tiver processado a fila (long polling de 20s)."
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const ESPERADO = 5;",
                  "const MAX_TENTATIVAS = 20;",
                  "let tentativas = Number(pm.collectionVariables.get('tentativas') || 0);",
                  "",
                  "// 404 enquanto nada da sessão foi gravado ainda.",
                  "const corpo = pm.response.code === 200 ? pm.response.json() : { events: [] };",
                  "const total = corpo.events ? corpo.events.length : 0;",
                  "",
                  "if (total < ESPERADO && tentativas < MAX_TENTATIVAS) {",
                  "  // O worker faz long polling de 20s no SQS; a gravação não é imediata.",
                  "  pm.collectionVariables.set('tentativas', tentativas + 1);",
                  "  console.log(`aguardando o worker: ${total}/${ESPERADO} eventos (tentativa ${tentativas + 1})`);",
                  "  pm.execution.setNextRequest('3.1 Os eventos postados chegaram ao banco');",
                  "} else {",
                  "  pm.test('a sessão criada por POST é legível por GET', () => {",
                  "    pm.expect(pm.response.code).to.eql(200);",
                  "  });",
                  "  pm.test(`chegaram os ${ESPERADO} eventos únicos`, () => {",
                  "    pm.expect(total).to.eql(ESPERADO);",
                  "  });",
                  "  pm.test('o reenvio idêntico NÃO duplicou (idempotência)', () => {",
                  "    const ids = corpo.events.map(e => e.event_id);",
                  "    pm.expect(new Set(ids).size).to.eql(ids.length);",
                  "    const erros = corpo.events.filter(e => e.event_name === 'error');",
                  "    pm.expect(erros.length, '2.1 e 2.3 colidiram na mesma chave').to.eql(1);",
                  "  });",
                  "  pm.test('o tipo desconhecido foi gravado e é legível', () => {",
                  "    const novo = corpo.events.find(e => e.event_name === 'postman_probe');",
                  "    pm.expect(novo, 'o evento de tipo novo sumiu').to.not.be.undefined;",
                  "  });",
                  "  pm.test('os campos desconhecidos foram preservados', () => {",
                  "    const novo = corpo.events.find(e => e.event_name === 'postman_probe');",
                  "    pm.expect(novo.attributes.campo_que_o_backend_nunca_viu).to.eql('preservado');",
                  "  });",
                  "  pm.test('o payload inválido de 2.5 NÃO entrou na base', () => {",
                  "    pm.expect(total).to.eql(ESPERADO);",
                  "  });",
                  "  pm.execution.setNextRequest(null);",
                  "}"
                ]
              }
            }
          ]
        }
      ]
    },
